{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["tsjustworks-openai", "tsjustworks-anthropic", "tsjustworks"],
  "model": "tsjustworks-openai/gpt-5.6",
  "small_model": "tsjustworks-openai/gpt-5.6-luna",
  "provider": {
    "tsjustworks-openai": {
      "npm": "@ai-sdk/openai",
      "name": "Tailscale Justworks - OpenAI",
      "options": {
        "baseURL": "http://ai.tsjustworks.ts.net/v1",
        "apiKey": "tsjustworks"
      },
      "models": {
        "glm-5.2": {},
        "kimi-k2.7-code": {},
        "zai.glm-5": {},
        "openai.gpt-5.4": {},
        "openai.gpt-5.5": {},
        "gpt-5.6": {},
        "gpt-5.6-luna": {},
        "gpt-5.6-sol": {},
        "gpt-5.6-terra": {}
      }
    },
    "tsjustworks-anthropic": {
