# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
zstyle ':omz:update' mode reminder  # just remind me to update when it's time

COMPLETION_WAITING_DOTS="true"

if [ -r "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
fi

plugins=(git ssh-agent aws)

export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.cargo/bin:$HOME/.tfenv/bin:$HOME/.gobrew/current/bin:$HOME/.gobrew/bin:/opt/homebrew/bin:/opt/homebrew/lib/ruby/gems/3.1.0/bin:/opt/homebrew/opt/ruby/bin:$PATH"

if [[ "$OSTYPE" == linux* ]]; then
  export PATH="$HOME/.npm-global/bin:$PATH"
fi

# Starship
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# awsp
alias awsp='source "$(mise where github:abyss/go-awsp)/_source-awsp.sh"'

# GPG
# Add the following to your shell init to set up gpg-agent automatically for every shell
export GPG_TTY=$(tty)
if command -v gpgconf >/dev/null 2>&1; then
  gpgconf --launch gpg-agent >/dev/null 2>&1 || true
fi

if [ -d "$HOME/.kube/config.d" ]; then
  kube_configs=("$HOME"/.kube/config.d/*(N))
  if [ ${#kube_configs[@]} -gt 0 ]; then
    export KUBECONFIG="${KUBECONFIG:+$KUBECONFIG:}${(j/:/)kube_configs}"
  fi
fi

export EDITOR=vim
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Use the pi profile matching the active Tailscale account, or personal otherwise.
pi() {
  local account profile="${PI_PROFILE:-}"

  if [[ -z "$profile" ]]; then
    profile="personal"

    if command -v tailscale >/dev/null 2>&1; then
      account=$(tailscale switch --list 2>/dev/null | awk '
        NR > 1 && $NF ~ /\*$/ {
          sub(/\*$/, "", $NF)
          print $NF
          exit
        }
      ')

      if [[ -n "$account" && -d "$HOME/.pi/profiles/$account" ]]; then
        profile="$account"
      fi
    fi
  fi

  (
    export PI_CODING_AGENT_DIR="$HOME/.pi/profiles/$profile"
    exec mise exec -- pi "$@"
  )
}

# Use the OpenCode profile matching the active Tailscale account, or base config otherwise.
opencode() {
  local account profile="${OPENCODE_PROFILE:-${OC_PROFILE:-}}" config

  if [[ -z "$profile" ]]; then
    profile="personal"

    if command -v tailscale >/dev/null 2>&1; then
      account=$(tailscale switch --list 2>/dev/null | awk '
        NR > 1 && $NF ~ /\*$/ {
          sub(/\*$/, "", $NF)
          print $NF
          exit
        }
      ')

      if [[ -n "$account" && -f "$HOME/.config/opencode/profiles/$account.jsonc" ]]; then
        profile="$account"
      fi
    fi
  fi

  config="$HOME/.config/opencode/profiles/$profile.jsonc"
  if [[ -f "$config" ]]; then
    OPENCODE_CONFIG="$config" mise -E "$profile" exec -- fnox --profile "$profile" --no-defaults exec -- opencode "$@"
  else
    mise -E "$profile" exec -- opencode "$@"
  fi
}
